      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [ { "source": "/acceuil", "destination": "/index.html" },
                  { "source": "/catalogue", "destination": "/html/catalogue.html" },
                  { "source": "/apropos", "destination": "/html/apropos.html" },
